# LLM API Configuration
# Base URL for OpenAI-compatible endpoint (e.g. OpenAI, Ollama, vLLM, LM Studio, or local mock server)
OPENAI_BASE_URL=http://localhost:8000/v1

# API Authentication Key
OPENAI_API_KEY=your_api_key_here

# LLM Model Identifier (e.g., gpt-4o-mini, llama3.2, mistral)
OPENAI_MODEL_NAME=gpt-4o-mini
